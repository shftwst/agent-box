#!/usr/bin/env python3
"""In-box client for the host worker broker. See docs/herdr-worker-broker.md.

Speaks the line protocol to CAGE_WORKER_SOCKET and prints the reply as JSON.
Knows nothing about Herdr, holds no socket to it, and has no way to express a
command: the broker on the host decides what every worker runs.
"""

import json
import os
import socket
import sys

USAGE = """usage:
  box-worker spawn <name> [--kind K] [--model M] [--base-url URL] [--auth-token T] [--effort L]
  box-worker ask   <name> <text> [--timeout MS]
  box-worker read  <name> [--lines N]
  box-worker poll  <name>
  box-worker close <name>
  box-worker list

names match [a-z][a-z0-9_-]{0,31} and refer only to workers this box created.
spawn --model / --base-url / --auth-token set the worker's ANTHROPIC_MODEL,
ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN, so the orchestrator can point a
worker at any model or endpoint, including a local one."""

VALUE_FLAGS = {"--timeout", "--lines", "--kind", "--model", "--small-fast-model",
               "--base-url", "--auth-token", "--effort"}


def flag_value(rest, name):
    return rest[rest.index(name) + 1] if name in rest else None


def free_text(rest):
    out, skip = [], False
    for token in rest:
        if skip:
            skip = False
        elif token in VALUE_FLAGS:
            skip = True
        elif not token.startswith("--"):
            out.append(token)
    return out


def call(request):
    path = os.environ.get("CAGE_WORKER_SOCKET")
    if not path:
        sys.exit("box-worker: no worker broker in this box (launch it with --workers)")
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        conn.connect(path)
    except OSError as exc:
        sys.exit(f"box-worker: cannot reach the broker at {path}: {exc}")
    with conn, conn.makefile("rw") as stream:
        stream.write(json.dumps(request) + "\n")
        stream.flush()
        reply = stream.readline()
    if not reply:
        sys.exit("box-worker: broker closed the connection")
    return json.loads(reply)


def parse(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        sys.exit(0)

    verb, rest = argv[0], argv[1:]
    if verb == "list":
        return {"verb": "list"}
    if verb not in ("spawn", "ask", "read", "poll", "close"):
        sys.exit(f"box-worker: unknown verb {verb!r}\n\n{USAGE}")
    if not rest:
        sys.exit(f"box-worker: {verb} needs a worker name\n\n{USAGE}")

    request = {"verb": verb, "name": rest[0]}
    rest = rest[1:]

    if verb == "ask":
        text = free_text(rest)
        if not text:
            sys.exit("box-worker: ask needs some text")
        request["text"] = " ".join(text)
        timeout = flag_value(rest, "--timeout")
        if timeout is not None:
            request["timeout"] = int(timeout)
    elif verb == "read":
        lines = flag_value(rest, "--lines")
        if lines is not None:
            request["lines"] = int(lines)
    elif verb == "spawn":
        for flag, key in (("--kind", "kind"), ("--model", "model"),
                          ("--small-fast-model", "small_fast_model"),
                          ("--base-url", "base_url"), ("--auth-token", "auth_token"),
                          ("--effort", "effort")):
            value = flag_value(rest, flag)
            if value is not None:
                request[key] = value

    return request


def main():
    reply = call(parse(sys.argv[1:]))
    print(json.dumps(reply, indent=2))
    sys.exit(0 if reply.get("ok") else 1)


if __name__ == "__main__":
    main()
