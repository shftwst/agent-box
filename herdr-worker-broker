#!/usr/bin/env python3
"""Host-side Herdr worker broker. See docs/herdr-worker-broker.md.

Holds the Herdr socket so the box never has to. The box gets a line protocol
with six verbs and no field anywhere that a command could travel in: this
process composes every Herdr command line itself, from values fixed on the
host before the box existed.

Two rules keep that true. Remove either and this is a plain socket relay again:

  * every subprocess call passes a list argv and never a shell string, so a
    worker name cannot become a command however it is spelled;
  * every verb resolves a name through this process's own registry, so a pane
    it did not create cannot be named at all.

The one value the box may choose beyond a worker name is the agent kind, and
only from the --allow list the host fixed at startup.
"""

import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import time

NAME = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
ORCHESTRATOR_RATIO = 0.65
WORKER_RATIO = 0.5
POLL_INTERVAL = 0.5
MAX_ENV = 8192

# Values the box may set on a worker's environment. The box orchestrates and
# knows the task, so it picks the model and endpoint freely; the broker only
# refuses a value it could not carry safely (empty, oversized, control chars).
WORKER_ENV = {
    "model": "ANTHROPIC_MODEL",
    "small_fast_model": "ANTHROPIC_SMALL_FAST_MODEL",
    "base_url": "ANTHROPIC_BASE_URL",
    "auth_token": "ANTHROPIC_AUTH_TOKEN",
}

# Pane output that means a spawned worker of a kind is at its prompt. claude is
# confirmed; codex matches its composer marker and is unverified against a caged
# codex. Override or extend per kind with --ready-regex KIND=REGEX.
READY_REGEX = {
    "claude": r"bypass permissions on|\? for shortcuts",
    "codex": r"Ask Codex to do anything",
    "pi": r"ctrl\+c/ctrl\+d clear/exit",
}

# Claude Code effort levels. claude-box turns CLAUDE_BOX_EFFORT into --effort.
EFFORTS = ("low", "medium", "high", "xhigh", "max")

# The qwen gateway lists all six effort names but only serves low and medium;
# minimal, high, xhigh and max return a 500, so fold them onto the nearest level
# that works. This is a workaround for that gateway, not a property of qwen.
QWEN_EFFORT_FALLBACK = {"minimal": "low", "high": "medium", "xhigh": "medium", "max": "medium"}


class Refused(Exception):
    pass


class Broker:
    def __init__(self, opts):
        self.opts = opts
        self.workers = {}
        self.dock_tail = None
        self.lock = threading.Lock()

    # -- Herdr ------------------------------------------------------------
    def _herdr(self, *args, wait_ms=None):
        budget = (wait_ms if wait_ms is not None else self.opts.timeout_cap)
        result = subprocess.run(
            [self.opts.herdr_bin, *args],
            capture_output=True,
            text=True,
            timeout=budget / 1000 + 30,
        )
        if result.returncode != 0:
            raise Refused(f"herdr {args[0]} {args[1]} failed: {result.stderr.strip()[:200]}")
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            return {"raw": result.stdout}

    def _status(self, pane):
        return self._herdr("agent", "get", pane).get("result", {}).get("agent", {}).get("agent_status")

    # Herdr cannot detect a caged agent's readiness or completion: agent state
    # falls back to idle for a worker whose TUI runs behind a container tty, so
    # spawn waits for the harness to render its prompt and ask watches for a
    # working-then-idle transition rather than trusting a single idle sample.
    def _await_ready(self, pane, kind):
        regex = self.opts.ready_regex.get(kind) or "|".join(self.opts.ready_regex.values())
        self._herdr(
            "pane", "wait-output", pane,
            "--regex", regex,
            "--timeout", str(self.opts.ready_timeout),
            wait_ms=self.opts.ready_timeout,
        )

    def _await_idle(self, pane, timeout):
        start = time.monotonic()
        saw_working = False
        while True:
            status = self._status(pane)
            if status == "working":
                saw_working = True
            elif status == "idle":
                if saw_working:
                    return status
                if (time.monotonic() - start) * 1000 >= self.opts.idle_grace:
                    return status
            if (time.monotonic() - start) * 1000 >= timeout:
                raise Refused("worker did not return within timeout")
            time.sleep(POLL_INTERVAL)

    def _pane_of(self, name):
        if name not in self.workers:
            raise Refused(f"no worker named {name!r}")
        return self.workers[name]

    # `pane split --env KEY=VALUE` sets the value on the pane process directly,
    # which the launcher inherits. The broker passes it as one argv element, so a
    # value never reaches a shell and cannot become a command.
    def _worker_env(self, req):
        chosen = {}
        for field, var in WORKER_ENV.items():
            value = req.get(field)
            if value is None:
                continue
            if not isinstance(value, str) or not value:
                raise Refused(f"{field} must be a non-empty string")
            if len(value) > MAX_ENV or any(ord(c) < 0x20 or ord(c) == 0x7f for c in value):
                raise Refused(f"{field} value is unusable (too long or has control characters)")
            chosen[var] = value
        # A worker on a local-only endpoint has no Claude model for the small,
        # fast background calls, so point those at the same model unless the box
        # set one, matching claude-box's ollama preset.
        if "ANTHROPIC_MODEL" in chosen:
            chosen.setdefault("ANTHROPIC_SMALL_FAST_MODEL", chosen["ANTHROPIC_MODEL"])
        args = []
        for var, value in chosen.items():
            args += ["--env", f"{var}={value}"]
        return args

    # Effort becomes claude's --effort, carried as CLAUDE_BOX_EFFORT. The box
    # passes its usual level and the broker adjusts it for the model: a qwen
    # endpoint has no high or max, so those fold onto xhigh. Returns the level
    # actually applied, or None, and appends the env to args.
    def _worker_effort(self, req, args):
        effort = req.get("effort")
        if effort is None:
            return None
        if not isinstance(effort, str) or effort not in EFFORTS:
            raise Refused(f"effort must be one of {', '.join(EFFORTS)}")
        if "qwen" in (req.get("model") or "").lower():
            effort = QWEN_EFFORT_FALLBACK.get(effort, effort)
        args += ["--env", f"CLAUDE_BOX_EFFORT={effort}"]
        return effort

    # A codex profile names a $CODEX_HOME/<name>.config.toml that fixes the
    # model, provider and effort. codex-box turns CODEX_BOX_PROFILE into -p.
    def _worker_profile(self, req, args):
        profile = req.get("profile")
        if profile is None:
            return None
        if (not isinstance(profile, str) or not profile or len(profile) > MAX_ENV
                or any(ord(c) < 0x20 or ord(c) == 0x7f for c in profile)):
            raise Refused("profile is empty or has an unusable value")
        args += ["--env", f"CODEX_BOX_PROFILE={profile}"]
        return profile

    # -- verbs ------------------------------------------------------------
    def spawn(self, req):
        name = req.get("name", "")
        if not isinstance(name, str) or not NAME.match(name):
            raise Refused("name must match [a-z][a-z0-9_-]{0,31}")
        if name in self.workers:
            raise Refused(f"{name} already exists")
        if len(self.workers) >= self.opts.max_workers:
            raise Refused(f"worker limit reached ({self.opts.max_workers})")

        kind = req.get("kind") or next(iter(self.opts.allowed))
        if kind not in self.opts.allowed:
            raise Refused(f"kind {kind!r} not permitted (allowed: {', '.join(self.opts.allowed)})")

        env_args = self._worker_env(req)
        effort = self._worker_effort(req, env_args)
        profile = self._worker_profile(req, env_args)

        if self.dock_tail is None:
            split = self._herdr(
                "pane", "split", "--pane", self.opts.pane,
                "--direction", "right", "--ratio", str(ORCHESTRATOR_RATIO),
                "--cwd", self.opts.project, *env_args,
                "--no-focus",
            )
        else:
            split = self._herdr(
                "pane", "split", "--pane", self.dock_tail,
                "--direction", "down", "--ratio", str(WORKER_RATIO),
                "--cwd", self.opts.project, *env_args,
                "--no-focus",
            )

        pane = split.get("result", {}).get("pane", {}).get("pane_id")
        if not pane:
            raise Refused("herdr pane split returned no pane id")

        # The launcher is the box wrapper the host fixed for this kind, so the
        # worker is itself a cage. `agent start --kind` would run Herdr's own
        # host harness uncaged, so run the wrapper as the pane's command instead.
        try:
            self._herdr("pane", "run", pane, self.opts.allowed[kind])
            self._await_ready(pane, kind)
        except Refused:
            self._herdr("pane", "close", pane)
            raise

        self.workers[name] = pane
        self.dock_tail = pane
        result = {"name": name, "pane": pane, "kind": kind}
        for field in ("model", "base_url"):
            if req.get(field) is not None:
                result[field] = req[field]
        if effort is not None:
            result["effort"] = effort
        if profile is not None:
            result["profile"] = profile
        return result

    def ask(self, req):
        pane = self._pane_of(req.get("name", ""))
        text = req.get("text", "")
        if not isinstance(text, str) or not text:
            raise Refused("text is required")
        if len(text.encode()) > self.opts.max_prompt:
            raise Refused(f"prompt over {self.opts.max_prompt} bytes")
        timeout = min(int(req.get("timeout", self.opts.timeout_cap)), self.opts.timeout_cap)
        self._herdr("agent", "prompt", pane, text)
        self._await_idle(pane, timeout)
        return {"status": self._herdr("agent", "get", pane).get("result", {})}

    def read(self, req):
        pane = self._pane_of(req.get("name", ""))
        lines = min(int(req.get("lines", 200)), self.opts.max_lines)
        reply = self._herdr("pane", "read", pane, "--lines", str(lines))
        return {"text": reply.get("raw", reply.get("result", reply))}

    def poll(self, req):
        pane = self._pane_of(req.get("name", ""))
        return {"status": self._herdr("agent", "get", pane).get("result", {})}

    def close(self, req):
        name = req.get("name", "")
        pane = self._pane_of(name)
        self._herdr("pane", "close", pane)
        del self.workers[name]
        if self.dock_tail == pane:
            self.dock_tail = next(reversed(list(self.workers.values())), None)
        return {"closed": name}

    def list(self, _req):
        return {"workers": [{"name": n, "pane": p} for n, p in self.workers.items()]}

    VERBS = {"spawn": spawn, "ask": ask, "read": read, "poll": poll, "close": close, "list": list}

    def handle(self, line):
        try:
            req = json.loads(line)
            if not isinstance(req, dict):
                raise Refused("request must be an object")
            verb = req.get("verb")
            if verb not in self.VERBS:
                raise Refused(f"unknown verb {verb!r}")
            with self.lock:
                return {"ok": True, **self.VERBS[verb](self, req)}
        except Refused as exc:
            return {"ok": False, "error": str(exc)}
        except (json.JSONDecodeError, ValueError, TypeError) as exc:
            return {"ok": False, "error": f"bad request: {exc}"}
        except subprocess.TimeoutExpired:
            return {"ok": False, "error": "herdr call timed out"}

    def shutdown(self):
        for pane in self.workers.values():
            try:
                self._herdr("pane", "close", pane)
            except Exception:
                pass


def log(path, message):
    with open(path, "a") as handle:
        handle.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {message}\n")


SUN_PATH_MAX = 100


def serve(broker, sock_path, log_path):
    if len(sock_path.encode()) > SUN_PATH_MAX:
        sys.exit(
            f"herdr-worker-broker: socket path is {len(sock_path)} bytes, over the "
            f"{SUN_PATH_MAX} a unix socket allows: {sock_path}"
        )
    os.makedirs(os.path.dirname(sock_path), exist_ok=True)
    if os.path.exists(sock_path):
        os.unlink(sock_path)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(sock_path)
    os.chmod(sock_path, 0o600)
    server.listen(8)
    log(log_path, f"listening on {sock_path} for pane {broker.opts.pane}")

    while True:
        conn, _ = server.accept()
        threading.Thread(target=session, args=(broker, conn, log_path), daemon=True).start()


def session(broker, conn, log_path):
    with conn, conn.makefile("rw") as stream:
        for line in stream:
            line = line.strip()
            if not line:
                continue
            reply = broker.handle(line)
            log(log_path, ("ACCEPT " if reply.get("ok") else "REFUSE ") + line[:300])
            stream.write(json.dumps(reply) + "\n")
            stream.flush()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pane", required=True, help="orchestrator pane id, the registry key")
    parser.add_argument("--project", required=True, help="cwd every worker is given")
    parser.add_argument("--allow", required=True, action="append", metavar="KIND=LAUNCHER",
                        help="permitted agent kind and the host wrapper it runs, repeatable. "
                             "The first is the default. A kind not named here cannot be spawned.")
    parser.add_argument("--socket", required=True)
    parser.add_argument("--log", required=True)
    parser.add_argument("--max-workers", type=int, default=4)
    parser.add_argument("--max-prompt", type=int, default=8192)
    parser.add_argument("--max-lines", type=int, default=2000)
    parser.add_argument("--timeout-cap", type=int, default=600000)
    parser.add_argument("--ready-regex", action="append", default=[], metavar="KIND=REGEX",
                        help="override the readiness pattern for a kind, repeatable. "
                             "Built-in defaults cover claude and codex.")
    parser.add_argument("--ready-timeout", type=int, default=300000,
                        help="how long to wait for a spawned worker to reach its prompt, "
                             "generous because a cold cage can take minutes to start")
    parser.add_argument("--idle-grace", type=int, default=15000,
                        help="how long ask waits for a worker to start working before "
                             "treating a still-idle worker as an instant reply")
    parser.add_argument("--herdr-bin", default=os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr"))
    opts = parser.parse_args()

    if os.environ.get("HERDR_ENV") != "1":
        sys.exit("herdr-worker-broker: not inside a Herdr pane")
    if not opts.herdr_bin:
        sys.exit("herdr-worker-broker: no herdr binary on PATH")
    if not os.path.isdir(opts.project):
        sys.exit(f"herdr-worker-broker: no such project dir: {opts.project}")

    opts.allowed = {}
    for entry in opts.allow:
        kind, _, launcher = entry.partition("=")
        if not kind or not os.access(launcher, os.X_OK):
            sys.exit(f"herdr-worker-broker: bad --allow {entry!r}")
        opts.allowed[kind] = launcher

    ready = dict(READY_REGEX)
    for entry in opts.ready_regex:
        kind, sep, regex = entry.partition("=")
        if not kind or not sep or not regex:
            sys.exit(f"herdr-worker-broker: bad --ready-regex {entry!r} (want KIND=REGEX)")
        ready[kind] = regex
    opts.ready_regex = ready

    broker = Broker(opts)

    try:
        serve(broker, opts.socket, opts.log)
    except KeyboardInterrupt:
        pass
    finally:
        broker.shutdown()
        if os.path.exists(opts.socket):
            os.unlink(opts.socket)


if __name__ == "__main__":
    main()
